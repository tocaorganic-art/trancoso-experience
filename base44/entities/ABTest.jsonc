{
  "name": "ABTest",
  "type": "object",
  "properties": {
    "test_name": {
      "type": "string",
      "description": "Nome do teste A/B"
    },
    "variant": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ],
      "description": "Variante do teste"
    },
    "element_tested": {
      "type": "string",
      "description": "Elemento sendo testado (CTA, form, price, etc)"
    },
    "user_session_id": {
      "type": "string",
      "description": "ID da sess\u00e3o do usu\u00e1rio"
    },
    "viewed": {
      "type": "boolean",
      "default": true,
      "description": "Se o usu\u00e1rio viu a variante"
    },
    "clicked": {
      "type": "boolean",
      "default": false,
      "description": "Se o usu\u00e1rio clicou"
    },
    "converted": {
      "type": "boolean",
      "default": false,
      "description": "Se o usu\u00e1rio converteu"
    },
    "revenue": {
      "type": "number",
      "description": "Receita gerada (se aplic\u00e1vel)"
    }
  },
  "required": [
    "test_name",
    "variant",
    "element_tested"
  ]
}