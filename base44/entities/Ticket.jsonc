{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "evento_id": {
      "type": "string",
      "description": "ID do evento (EventoAnoNovo)"
    },
    "nome": {
      "type": "string",
      "description": "Nome do tipo de ingresso"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do ingresso"
    },
    "preco": {
      "type": "number",
      "description": "Pre\u00e7o do ingresso em R$"
    },
    "quantidade_total": {
      "type": "number",
      "description": "Quantidade total de ingressos"
    },
    "quantidade_vendida": {
      "type": "number",
      "default": 0,
      "description": "Quantidade j\u00e1 vendida"
    },
    "quantidade_disponivel": {
      "type": "number",
      "description": "Quantidade dispon\u00edvel (calculada)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "pista",
        "vip",
        "camarote",
        "open_bar",
        "mesa"
      ],
      "default": "pista",
      "description": "Tipo de ingresso"
    },
    "beneficios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Benef\u00edcios inclusos"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 dispon\u00edvel para venda"
    },
    "lote": {
      "type": "string",
      "description": "Lote do ingresso (ex: 1\u00ba lote, 2\u00ba lote)"
    }
  },
  "required": [
    "evento_id",
    "nome",
    "preco",
    "quantidade_total"
  ]
}