{
  "name": "AdminUser",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email do administrador"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash bcrypt da senha"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo do admin"
    },
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "viewer"
      ],
      "default": "admin",
      "description": "N\u00edvel de acesso"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltimo login"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Status da conta"
    }
  },
  "required": [
    "email",
    "password_hash"
  ]
}