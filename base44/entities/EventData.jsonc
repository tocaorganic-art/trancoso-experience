{
  "name": "EventData",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "client_email": {
      "type": "string",
      "format": "email",
      "description": "Email do cliente"
    },
    "client_phone": {
      "type": "string",
      "description": "Telefone/WhatsApp do cliente"
    },
    "event_type": {
      "type": "string",
      "description": "Tipo do evento"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Data do evento"
    },
    "budget_requested": {
      "type": "string",
      "description": "Faixa de or\u00e7amento solicitada"
    },
    "message": {
      "type": "string",
      "description": "Mensagem adicional do cliente"
    },
    "conversion_status": {
      "type": "string",
      "enum": [
        "pending",
        "contacted",
        "proposal_sent",
        "negotiating",
        "converted",
        "lost"
      ],
      "default": "pending",
      "description": "Status da convers\u00e3o"
    },
    "budget_final": {
      "type": "number",
      "description": "Or\u00e7amento final fechado"
    },
    "lead_score": {
      "type": "number",
      "description": "Score do lead (0-100)"
    },
    "source": {
      "type": "string",
      "default": "website",
      "description": "Origem do lead"
    }
  },
  "required": [
    "client_name",
    "client_email",
    "client_phone"
  ]
}